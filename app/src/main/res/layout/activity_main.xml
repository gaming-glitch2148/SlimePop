<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/main_bg_radial">

    <!-- ═══════════════════════════════════════════════
         LAYER 1 – Full-screen slime canvas
         Everything else floats on top via z-order
         ═══════════════════════════════════════════════ -->
    <com.slimepop.asmr.SlimeView
        android:id="@+id/slimeView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Anchor guideline at 40% height for side pill positioning -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/midGuide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.40" />

    <!-- ═══════════════════════════════════════════════
         LAYER 2 – Top floating HUD
         ═══════════════════════════════════════════════ -->

    <!-- Settings · Sound · Leaderboard (top-left) -->
    <LinearLayout
        android:id="@+id/topLeftControls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/control_icon_bg"
            android:contentDescription="Settings"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@android:drawable/ic_menu_manage"
            app:tint="#E8ECFF" />

        <ImageButton
            android:id="@+id/btnToggleSound"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/control_icon_bg"
            android:contentDescription="Sound on"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@android:drawable/ic_lock_silent_mode_off"
            app:tint="#E8ECFF" />

        <ImageButton
            android:id="@+id/btnLeaderboard"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/control_icon_bg"
            android:contentDescription="Leaderboard"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@android:drawable/btn_star_big_on"
            app:tint="#FFD84D" />
    </LinearLayout>

    <!-- Coin count chip (top-center) -->
    <LinearLayout
        android:id="@+id/coinChip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/glass_hud_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@android:drawable/btn_star_big_on"
            app:tint="#FFD84D" />

        <TextView
            android:id="@+id/tvCoins"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="0"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- VIP/Premium button (top-right) -->
    <Button
        android:id="@+id/btnRemoveAds"
        android:layout_width="wrap_content"
        android:layout_height="38dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/premium_chip_bg"
        android:minWidth="0dp"
        android:paddingStart="11dp"
        android:paddingEnd="11dp"
        android:text="BUY VIP PASS"
        android:textAllCaps="true"
        android:textColor="#2F1900"
        android:textSize="9sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- ═══════════════════════════════════════════════
         LAYER 3 – Left-side floating pills (daily + quest)
         Anchored at ~40% height so they sit mid-slime
         ═══════════════════════════════════════════════ -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:orientation="vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintTop_toBottomOf="@id/midGuide">

        <!-- Daily reward pill -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/glass_hud_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="8dp">

            <TextView
                android:id="@+id/tvDaily"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="Fire x1"
                android:textColor="#FFD6A8"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnDaily"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/ad_square_button_bg"
                android:minWidth="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="Daily"
                android:textAllCaps="false"
                android:textColor="#F3F8FF"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Quest pill -->
        <LinearLayout
            android:id="@+id/questPanel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:background="@drawable/glass_hud_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="8dp">

            <TextView
                android:id="@+id/tvQuest"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="Quest ready"
                android:textColor="#CFF6FF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnQuest"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/ad_square_button_bg"
                android:minWidth="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="Quest"
                android:textAllCaps="false"
                android:textColor="#F3F8FF"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- ═══════════════════════════════════════════════
         LAYER 4 – Bottom floating dock
         ═══════════════════════════════════════════════ -->

    <!-- Equipped skin · sound label (just above dock) -->
    <TextView
        android:id="@+id/tvEquipped"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:text="Ocean • Soft Rain"
        android:textColor="#66D2DDF0"
        android:textSize="11sp"
        app:layout_constraintBottom_toTopOf="@+id/bottomDock"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Compact 4-button dock: Shop · Watch · Skins · Relax -->
    <LinearLayout
        android:id="@+id/bottomDock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="18dp"
        android:background="@drawable/dock_glass_bg"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="9dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnShop"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/dock_circle_shop_bg"
            android:drawableTop="@android:drawable/ic_menu_agenda"
            android:drawablePadding="3dp"
            android:gravity="center"
            android:padding="6dp"
            android:text="SHOP"
            android:textAllCaps="true"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold" />

        <Space android:layout_width="8dp" android:layout_height="wrap_content" />

        <Button
            android:id="@+id/btnRewardedBoost"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/ad_square_button_bg"
            android:drawableTop="@android:drawable/ic_menu_slideshow"
            android:drawablePadding="3dp"
            android:gravity="center"
            android:padding="6dp"
            android:text="WATCH&#10;AD"
            android:textAllCaps="true"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold" />

        <Space android:layout_width="8dp" android:layout_height="wrap_content" />

        <Button
            android:id="@+id/btnSkins"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/dock_circle_skins_bg"
            android:drawableTop="@android:drawable/ic_menu_gallery"
            android:drawablePadding="3dp"
            android:gravity="center"
            android:padding="6dp"
            android:text="SKINS"
            android:textAllCaps="true"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold" />

        <Space android:layout_width="8dp" android:layout_height="wrap_content" />

        <Button
            android:id="@+id/btnRelax"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/relax_button_bg"
            android:drawableTop="@android:drawable/ic_menu_recent_history"
            android:drawablePadding="3dp"
            android:gravity="center"
            android:padding="6dp"
            android:text="RELAX"
            android:textAllCaps="true"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ═══════════════════════════════════════════════
         COMPATIBILITY – kept for MainActivity but hidden
         btnPremiumBanner: text/animation still works on
         a GONE view (ObjectAnimator is a no-op on gone)
         ═══════════════════════════════════════════════ -->
    <Button
        android:id="@+id/btnPremiumBanner"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
